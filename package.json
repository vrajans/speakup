{
  "name": "speakup",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node --experimental-sqlite server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --experimental-sqlite server/index.js",
    "client": "cd client && npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.2"
  }
}
